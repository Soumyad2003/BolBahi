# GEMINI_API_KEY (Optional): Enables Gemini Flash-Lite voice parsing and Gemini TTS.
# BolBahi starts and runs completely without a .env file or API key using its
# built-in Offline Local Hinglish parser, Trie/Levenshtein intent matcher, and browser voice.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL (Optional): Public URL where BolBahi is hosted (defaults to http://localhost:3000).
APP_URL="http://localhost:3000"
